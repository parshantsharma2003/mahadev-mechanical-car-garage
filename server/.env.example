# ==============================================================================
# Mahadev Mechanical Car Garage - Backend Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - Copy this file to .env for local development.
# - In production (Render dashboard), set these variables in the Environment settings.
# - NEVER commit actual secrets, credentials, or production connection strings to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Environment & Network
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'production', or 'test'
NODE_ENV=production

# Server listening port (Render automatically assigns PORT)
PORT=5000

# Canonical Frontend URL for CORS allowlist and cookie domain validation
# In production on Vercel: https://mahadev-mechanical-car-garage.vercel.app or https://www.mahadevgarage.com
FRONTEND_URL=https://mahadev-mechanical-car-garage.vercel.app

# ------------------------------------------------------------------------------
# 2. MongoDB Database Connection (Atlas Replica Set for Production)
# ------------------------------------------------------------------------------
# Atlas replica sets provide high availability and multi-document ACID transactions.
# Format: mongodb+srv://<username>:<password>@<cluster-address>/mahadev_garage?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mahadev_garage?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Security Secrets (CRITICAL: Must be at least 32 characters in production)
# ------------------------------------------------------------------------------
# Generate 64-char cryptographically secure keys:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
CSRF_SECRET=replace_with_a_secure_random_64_character_hex_string

# ------------------------------------------------------------------------------
# 4. Cookie & Cross-Domain Configuration (Render <-> Vercel)
# ------------------------------------------------------------------------------
# Set to 'true' when frontend and backend are hosted on different top-level domains.
IS_CROSS_DOMAIN=true

# SameSite policy: 'none' for cross-domain HTTPS (Vercel <-> Render), 'lax' for shared domain
COOKIE_SAME_SITE=none

# Secure cookie flag: 'true' requires HTTPS (mandatory when SameSite=None)
COOKIE_SECURE=true

# Optional shared root cookie domain (e.g., '.mahadevgarage.com' if using custom domains)
# COOKIE_DOMAIN=.mahadevgarage.com

# ------------------------------------------------------------------------------
# 5. Rate Limiting Protection (Brute-Force & Denial-of-Service Defense)
# ------------------------------------------------------------------------------
# General API limiter window in milliseconds (default: 15 minutes = 900000ms)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window for general API
RATE_LIMIT_MAX=300

# Max login attempts per 15-minute window per IP
AUTH_RATE_LIMIT_MAX=15

# ------------------------------------------------------------------------------
# 6. Initial OWNER Account Provisioning Credentials (Used by seed script)
# ------------------------------------------------------------------------------
OWNER_INIT_NAME=Mahadev Garage Owner
OWNER_INIT_EMAIL=owner@mahadevgarage.com
OWNER_INIT_PASSWORD=replace_with_a_secure_initial_owner_password
OWNER_INIT_PHONE=8295669463
