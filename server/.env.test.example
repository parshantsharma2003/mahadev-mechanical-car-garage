# ==============================================================================
# Mahadev Mechanical Car Garage - Automated Test Environment Configuration
# ==============================================================================
# This environment file is used strictly for offline/isolated testing.
# Production Atlas URIs are explicitly blocked by testSafetyGuard.js.

NODE_ENV=test
PORT=5055

# Isolated local test database (MUST end with _test, e.g. mahadev_test)
MONGODB_URI=mongodb://127.0.0.1:27017/mahadev_test
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/mahadev_test

JWT_SECRET=test_jwt_secret_must_be_at_least_32_characters_long_for_security
CSRF_SECRET=test_csrf_secret_must_be_at_least_32_characters_long_for_security
IS_CROSS_DOMAIN=false
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000
AUTH_RATE_LIMIT_MAX=1000

OWNER_INIT_NAME=Test Garage Owner
OWNER_INIT_EMAIL=testowner@mahadevtest.com
OWNER_INIT_PASSWORD=TestOwnerPassword#2026
OWNER_INIT_PHONE=9999900001
